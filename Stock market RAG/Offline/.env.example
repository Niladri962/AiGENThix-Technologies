LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=4096
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
